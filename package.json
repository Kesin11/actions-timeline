{
  "name": "actions-timeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "biome check . && npm run typecheck && npm test",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.2",
    "date-fns": "4.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.0",
    "typescript": "^5.9.3"
  }
}
